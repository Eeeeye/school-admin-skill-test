{
	admin off
	log {
		format json
	}
}

{$PUBLIC_HOST} {
	encode zstd gzip
	log {
		format json
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}

	# Keep scanner/development paths out of the SPA fallback, even if a
	# dotfile is accidentally copied into the static output. ACME challenges
	# remain available for Caddy's automatic HTTPS renewal.
	route {
		@privateFiles {
			path_regexp privateFile (^|/)\.[^/]+
			not path_regexp acmeChallenge ^/\.well-known/acme-challenge/[A-Za-z0-9_-]+$
		}
		respond @privateFiles "Not found" 404
		@developmentPaths path /@fs /@fs/* /@vite /@vite/* /node_modules /node_modules/*
		respond @developmentPaths "Not found" 404

		handle /api/* {
			reverse_proxy {$BACKEND_UPSTREAM:backend:5007}
		}

		handle /backend-assets/* {
			uri strip_prefix /backend-assets
			reverse_proxy {$BACKEND_UPSTREAM:backend:5007}
		}

		# Only JSON certificate metadata is published; never expose the Kubo API.
		handle /ipfs/* {
			@write not method GET HEAD
			respond @write "Method not allowed" 405
			header Content-Security-Policy "default-src 'none'; sandbox"
			reverse_proxy {$IPFS_UPSTREAM:ipfs:8080} {
				header_up Host localhost
			}
		}

		handle /health {
			respond "ok" 200
		}

		# Missing built assets must return 404, never the SPA HTML document.
		handle /assets/* {
			root * /srv
			file_server
		}

		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}

# This listener is loopback-only inside the container, with no host port mapping.
http://:8081 {
	bind 127.0.0.1
	respond /health "ok" 200
}
