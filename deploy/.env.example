# Copy to deploy/.env.server, populate privately, and chmod 600 that file.
# PUBLIC_HOST is a DNS hostname only, without https://, port, or path.
PUBLIC_HOST=school.example.com
# Generate URL-safe random values independently (at least 32 bytes each).
# POSTGRES_PASSWORD must be URL-safe because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=GENERATE_URL_SAFE_RANDOM_PASSWORD
JWT_ACCESS_TOKEN_SECRET=GENERATE_DISTINCT_RANDOM_ACCESS_SECRET
JWT_REFRESH_TOKEN_SECRET=GENERATE_DISTINCT_RANDOM_REFRESH_SECRET
CSRF_TOKEN_SECRET=GENERATE_DISTINCT_RANDOM_CSRF_SECRET
EMAIL_VERIFICATION_TOKEN_SECRET=GENERATE_DISTINCT_RANDOM_EMAIL_SECRET
PASSWORD_SETUP_TOKEN_SECRET=GENERATE_DISTINCT_RANDOM_PASSWORD_SECRET
# Generate a new mnemonic at deployment, then derive its account-0 private key
# using m/44'/60'/0'/0/0. These two values must match and survive every restart.
LOCAL_CHAIN_MNEMONIC="GENERATE_NEW_PRIVATE_BIP39_MNEMONIC"
CERTIFICATE_PRIVATE_KEY=DERIVE_MATCHING_ACCOUNT_ZERO_PRIVATE_KEY
# Optional real invitation/password-setup delivery.
MAIL_FROM_USER=noreply@localhost.invalid
RESEND_API_KEY=
