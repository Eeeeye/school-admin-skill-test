  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "chai": "4.5.0",
    "dotenv": "^16.4.5",
    "ethers": "6.14.0",
    "ganache": "7.9.2",
    "hardhat": "^2.22.15",
    "solc": "0.8.24"
  }
}
