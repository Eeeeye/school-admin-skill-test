# Copy to .env when overriding the safe local defaults in docker-compose.yml.
# Never reuse these development values in production.
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret
CSRF_TOKEN_SECRET=replace-with-a-long-random-csrf-secret
EMAIL_VERIFICATION_TOKEN_SECRET=replace-with-a-long-random-email-secret
PASSWORD_SETUP_TOKEN_SECRET=replace-with-a-long-random-password-secret
