# global options
{
	admin off # theres no need for the admin api in railway's environment
	persist_config off # storage isn't persistent anyway
	auto_https off # railway handles https for us, this would cause issues if left enabled
	# runtime logs
	log {
		format json # set runtime log format to json mode 
	}
	# server options
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust railway's proxy
	}
}

# site block, listens on the $PORT environment variable, automatically assigned by railway
:{$PORT:3000} {
	# access logs
	log {
		format json # set access log format to json mode
	}

	# Keep scanner/development paths out of the SPA fallback, even if a
	# dotfile is accidentally copied into the static output. ACME challenges
	# remain available for Caddy's automatic HTTPS renewal.
	route {
		@privateFiles {
			path_regexp privateFile (^|/)\.[^/]+
			not path_regexp acmeChallenge ^/\.well-known/acme-challenge/[A-Za-z0-9_-]+$
		}
		respond @privateFiles "Not found" 404
		@developmentPaths path /@fs /@fs/* /@vite /@vite/* /node_modules /node_modules/*
		respond @developmentPaths "Not found" 404

		# Keep API traffic on the Compose network while the browser uses one origin.
		handle /api/* {
			reverse_proxy {$BACKEND_UPSTREAM:localhost:5007}
		}

		# The menu icons are served by the backend's public directory. Keep them
		# same-origin in Compose as well, so the browser does not need CORS.
		handle /backend-assets/* {
			uri strip_prefix /backend-assets
			reverse_proxy {$BACKEND_UPSTREAM:localhost:5007}
		}

		# Read-only content gateway; the IPFS administrative API is never exposed.
		handle /ipfs/* {
			@write not method GET HEAD
			respond @write "Method not allowed" 405
			reverse_proxy {$IPFS_UPSTREAM:localhost:8080}
		}

		# Lightweight container readiness endpoint.
		handle /health {
			respond "ok" 200
		}

		# Missing built assets must return 404, never the SPA HTML document.
		handle /assets/* {
			root * /srv
			file_server
		}

		handle {
			# serve the static files copied into the runtime image
			root * /srv

			# enable gzipping responses
			encode gzip

			# if path doesn't exist, redirect it to 'index.html' for client side routing
			try_files {path} /index.html
			file_server
		}
	}
}
