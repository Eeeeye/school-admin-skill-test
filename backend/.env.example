# Server Configuration
PORT=5007

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_mgmt

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
JWT_ACCESS_TOKEN_TIME_IN_MS=900000    # 15 minutes
JWT_REFRESH_TOKEN_TIME_IN_MS=28800000 # 8 hours

# CSRF Protection
CSRF_TOKEN_SECRET=your_csrf_secret_key_here
CSRF_TOKEN_TIME_IN_MS=950000 # 15 minutes + 50 seconds

# Email Configuration
MAIL_FROM_USER=noreply@yourschool.com
RESEND_API_KEY=re_your_resend_api_key_here

# Email Verification
EMAIL_VERIFICATION_TOKEN_SECRET=your_email_verification_secret_here
EMAIL_VERIFICATION_TOKEN_TIME_IN_MS=18000000 # 5 hours

# Password Setup
PASSWORD_SETUP_TOKEN_SECRET=your_password_setup_secret_here
PASSWORD_SETUP_TOKEN_TIME_IN_MS=300000 # 5 minutes

# Frontend URL (for email links)
UI_URL=http://localhost:5173

# Backend URL (for email links)
API_URL=http://localhost:5007

# Cookie Configuration
COOKIE_DOMAIN=localhost
# Set false only for local HTTP development; keep true behind HTTPS.
COOKIE_SECURE=false

# Environment
NODE_ENV=development

# Keep empty for direct local development. Public deployments must name only
# their internal reverse proxy, ideally its fixed Docker IP with a /32 prefix.
# TRUSTED_PROXY_CIDRS=172.30.0.2/32

# Explicit one-time administrator setup (never filled with shared defaults).
# Supply these only to npm run bootstrap:admin, then remove them from the
# long-running service environment. Production rejects the demo administrator.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=School Administrator

# Integrated certificate service. Docker Compose configures these automatically.
AUTO_MIGRATE=true
# DB_MIGRATIONS_DIR=../seed_db/migrations
CERTIFICATE_RPC_URL=http://127.0.0.1:8545
CERTIFICATE_PUBLIC_RPC_URL=http://localhost:8545
CERTIFICATE_DEPLOYMENT_FILE=../blockchain/deployments/localhost.json
CERTIFICATE_DEMO_MODE=true
# Use a dedicated authorized issuer key outside local development.
# CERTIFICATE_PRIVATE_KEY=
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://localhost:5173/ipfs
